SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# JWT secret của Supabase: Dashboard > Settings > API > JWT Secret
# (dùng để xác minh access_token do Supabase Auth cấp)
SUPABASE_JWT_SECRET=your-supabase-jwt-secret

# CORS origins cho frontend (comma-separated). Thêm domain Vercel production + preview
# Ví dụ: CORS_ORIGINS=http://localhost:3000,https://your-app.vercel.app
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000