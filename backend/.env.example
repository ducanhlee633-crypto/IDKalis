SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# JWT secret của Supabase: Dashboard > Settings > API > JWT Secret
# (dùng để xác minh access_token do Supabase Auth cấp)
SUPABASE_JWT_SECRET=your-supabase-jwt-secret

# CORS origins cho frontend (comma-separated).
# Backend LUÔN cho phép localhost (để local dev gọi được cả khi deploy).
# Chỉ cần set thêm domain Vercel production ở Render dashboard:
# Ví dụ: CORS_ORIGINS=https://idkalis.vercel.app,https://idkalis-abc123.vercel.app
# (không cần thêm localhost, đã auto-merge)
CORS_ORIGINS=https://your-app.vercel.app